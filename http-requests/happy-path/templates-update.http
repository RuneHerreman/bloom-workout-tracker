@baseUrl = http://localhost:8080/api/templates
@templateId = REPLACE_AFTER_CREATE
@token = REPLACE_AFTER_LOGIN

### Update workout template (full overwrite)
PUT {{baseUrl}}/{{templateId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Push + Cardio (revised)",
  "exercises": [
    {
      "exerciseId": "019d059e-d220-71db-8a1a-ec7569490001",
      "order": 0,
      "sets": [
        { "type": "Strength", "order": 0, "reps": 10 },
        { "type": "Strength", "order": 1, "reps": 8 },
        { "type": "Strength", "order": 2, "reps": 6 },
        { "type": "Strength", "order": 3, "reps": 4 }
      ]
    },
    {
      "exerciseId": "019d059e-d220-71db-8a1a-ec7569490051",
      "order": 1,
      "sets": [
        { "type": "Cardio", "order": 0, "duration": "00:30:00", "distance": 5.0, "distanceUnit": "Km" }
      ]
    }
  ]
}
