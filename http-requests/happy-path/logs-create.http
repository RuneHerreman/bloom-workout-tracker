@baseUrl = http://localhost:8080/api/logs
@token = REPLACE_AFTER_LOGIN

### Create workout log
POST {{baseUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "exercises": [
    {
      "exerciseId": "019d059e-d220-71db-8a1a-ec7569490001",
      "order": 0,
      "note": "Paused reps, felt strong",
      "gear": ["Lifting Belt"],
      "sets": [
        { "type": "Strength", "order": 0, "reps": 12, "weight": 40, "weightUnit": "Kg", "marker": "W" },
        { "type": "Strength", "order": 1, "reps": 8, "weight": 80, "weightUnit": "Kg", "rir": 1 },
        { "type": "Strength", "order": 2, "reps": 6, "weight": 85, "weightUnit": "Kg", "rir": 0 },
        { "type": "Strength", "order": 3, "reps": 10, "weight": 60, "weightUnit": "Kg", "rir": 0, "marker": "D" }
      ]
    },
    {
      "exerciseId": "019d059e-d220-71db-8a1a-ec7569490051",
      "order": 1,
      "gear": ["Nike Vaporfly", "Garmin Forerunner"],
      "sets": [
        { "type": "Cardio", "order": 0, "duration": "00:20:00", "distance": 3.5, "distanceUnit": "Km" }
      ]
    }
  ]
}
