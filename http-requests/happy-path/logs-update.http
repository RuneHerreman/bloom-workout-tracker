@baseUrl = http://localhost:8080/api/logs
@logId = REPLACE_AFTER_CREATE
@token = REPLACE_AFTER_LOGIN

### Update workout log (full overwrite)
PUT {{baseUrl}}/{{logId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "loggedAt": "2026-05-07T18:30:00Z",
