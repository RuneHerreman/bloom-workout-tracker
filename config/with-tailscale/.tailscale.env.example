# ==============================================================================
# Tailscale Configuration
# ==============================================================================
TS_AUTHKEY=tskey-auth-yourActualKeyHere

# ==============================================================================
# Database Configuration
# ==============================================================================
POSTGRES_DB=bloom
POSTGRES_USER=bloom_user
POSTGRES_PASSWORD=change_me_strong_password

# Database (API — must match above)
Database__Username=bloom_user
Database__Password=change_me_strong_password

# ==============================================================================
# API Configuration (.NET Injection Mapping)
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# JWT
Jwt__Key=REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS
Jwt__Issuer=bloom.workout
Jwt__Audience=users

# Strava
Strava__ClientId=YOUR_CLIENT_ID
Strava__ClientSecret=YOUR_CLIENT_SECRET
Strava__RedirectUri=https://YOUR_TAILSCALE_HOSTNAME/api/strava/callback
Strava__FrontendUrl=https://YOUR_TAILSCALE_HOSTNAME