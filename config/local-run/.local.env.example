##
# Copy this file to .local.env and fill in your own values.
# Never commit .local.env — it is git-ignored.
##

# Database (postgres image)
POSTGRES_DB=bloom
POSTGRES_USER=bloom_user
POSTGRES_PASSWORD=change_me_strong_password

# Database (API — must match above)
Database__Username=bloom_user
Database__Password=change_me_strong_password

# API
# Use Production for deployed environments — Development enables Scalar/OpenAPI docs.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# JWT — generate a random 64-char secret (e.g. openssl rand -hex 32)
Jwt__Key=REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS
Jwt__Issuer=bloom.workout
Jwt__Audience=users

# Strava — register your app at https://www.strava.com/settings/api
Strava__ClientId=YOUR_CLIENT_ID
Strava__ClientSecret=YOUR_CLIENT_SECRET
Strava__RedirectUri=http://localhost:8080/api/strava/callback
Strava__FrontendUrl=http://localhost:3000
