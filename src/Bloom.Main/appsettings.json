{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=bloom-db;Database=bloom;Username={username};Password={password}",
    "Username": "",
    "Password": ""
  },
  "Jwt": {
    "Issuer": "bloom",
    "Audience": "bloom-client",
    "Key": "__REPLACE_WITH_SECRET_VIA_ENV_Jwt__Key__",
    "ExpiryMinutes": 60
  },
  "Strava": {
    "ClientId": "__SET_VIA_ENV_Strava__ClientId__",
    "ClientSecret": "__SET_VIA_ENV_Strava__ClientSecret__",
    "RedirectUri": "http://localhost:8080/api/strava/callback",
    "FrontendUrl": "http://localhost:3000"
  }
}
