{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "ConnectionString": "Host=bloom-db;Database=bloom;Username={username};Password={password}",
    "Username": "",
    "Password": ""
  },
  "Jwt": {
    "Issuer": "bloom",
    "Audience": "bloom-client",
    "Key": "your-secret-key-minimum-32-characters-long",
    "ExpiryMinutes": 60
  }
}
