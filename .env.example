##
# Copy this file to .env and fill in your own values.
# Never commit .env — it is git-ignored.
##

# Database
POSTGRES_DB=bloom
POSTGRES_USER=bloom_user
POSTGRES_PASSWORD=change_me_strong_password

# API
# Use Production for deployed environments — Development enables Scalar/OpenAPI docs.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# JWT — generate a random 64-char secret (e.g. openssl rand -hex 32)
Jwt__Key=REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS
Jwt__Issuer=bloom.workout
Jwt__Audience=users
